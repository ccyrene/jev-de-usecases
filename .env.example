# Environment template for study de-laya-jev-th-en-2026.
# Copy to .env and fill in locally. Never commit .env, and never put a real key
# in this file, shell history, CI logs, results, or prompt text.

# --- Study ------------------------------------------------------------------
STUDY_ID=de-laya-jev-th-en-2026
SEED=20261019

# --- Remote Jev (TypeSafe API) ----------------------------------------------
# Offline by default. Paid remote calls happen only when ALLOW_REMOTE_API=1 AND
# TYPESAFE_API_KEY is non-empty; otherwise Jev rows are recorded as BLOCKED.
ALLOW_REMOTE_API=0
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pinned model ID. Never use jev-latest or jev-preview; the runner checks the
# version reported in every response and fails on mismatch.
JEV_MODEL=jev-1.14.0
# Optional P10 regression track (e.g. jev-1.13.0). Leave empty to skip.
JEV_REGRESSION_MODEL=
# Safety caps: remote calls stop before exceeding either one.
JEV_MAX_USD=5
JEV_MAX_REQUESTS=12000
JEV_MAX_RETRIES=3
JEV_TIMEOUT_S=30
# Upper bound for one backoff wait (seconds), including server Retry-After hints.
JEV_RETRY_MAX_WAIT_S=30
# Price per MILLION input tokens (not per thousand). Re-check
# https://docs.typesafe.ai/models before each run; the run manifest logs it.
JEV_USD_PER_MILLION_INPUT_TOKENS=0.042

# --- Local Laya -------------------------------------------------------------
# cpu | cuda
LAYA_DEVICE=cpu
LAYA_ROUTER_PRELOAD=1
LAYA_WARMUP_CALLS=30
# Optional overrides. Empty = use the pinned bundle revision in configs/models.yaml
# (convaiinnovations/laya@7b928d828b7b0e022f929d9bd2e44165aa270148).
LAYA_EN_MODEL=convaiinnovations/laya
LAYA_EN_REVISION=
LAYA_MULTI_MODEL=
LAYA_MULTI_REVISION=
# Optional model cache location.
# HF_HOME=/path/to/hf-cache

# --- Databases (synthetic data only) ----------------------------------------
# Run one compose profile at a time (e01..e05); E06 DuckDB is in-process.
# All ports bind to localhost only.
DB_BIND_HOST=127.0.0.1
# Passwords below are throwaway local credentials for synthetic containers.
# Set them in .env; never reuse a real password.

# E01 OpenSearch (single node). Password needs 8+ chars with upper, lower,
# digit and special character.
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_INDEX=airflow-task-logs

# E02 ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=debench
CLICKHOUSE_USER=debench
CLICKHOUSE_PASSWORD=

# E03 PostgreSQL (schema drift)
E03_POSTGRES_PORT=5433
E03_POSTGRES_DB=schema_drift
E03_POSTGRES_USER=debench
E03_POSTGRES_PASSWORD=

# E04 Neo4j Community Edition only; no enterprise features. Password 8+ chars.
NEO4J_EDITION=community
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# E05 PostgreSQL + JSONB (PII classification)
E05_POSTGRES_PORT=5434
E05_POSTGRES_DB=pii_catalog
E05_POSTGRES_USER=debench
E05_POSTGRES_PASSWORD=

# E06 DuckDB, opened read-only for candidate SQL
DUCKDB_PATH=data/warehouse.duckdb
SQL_QUERY_TIMEOUT_S=10

# --- Logging ----------------------------------------------------------------
# Raw request/response bodies are off by default. Enable only for synthetic
# runs; output goes to results/raw/ with secrets removed.
LOG_RAW_RESPONSES=0
RESULTS_DIR=results
